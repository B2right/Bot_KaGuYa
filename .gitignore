# ============================================================================
#  Bot_KaGuYa — 别把运行时和密钥推到公开仓库
# ============================================================================
#  原则：仓库只放「能重新搭起来」的东西（人格卡 / 文档 / 工具 / 配置样例）。
#        运行数据、密钥、第三方二进制一律不进。
# ============================================================================

# ---------- 密钥 / 凭据 ----------
.credentials.yaml
*credential*.json
*credential*.yaml
bili_credential.json
*.token
*.secret

# ---------- 运行时数据（含聊天记录，涉及隐私）----------
runtime/
!runtime/.gitkeep

# ---------- QQ 通道（2GB 第三方二进制 + 登录态）----------
napcat/

# ---------- Python 虚拟环境 ----------
.venv/
venv/
__pycache__/
*.pyc

# ---------- Node ----------
node_modules/
.pnpm-store/

# ---------- 构建产物 / 临时 ----------
dist/
build/
*.log
*.log.*
*.dmp
*.tmp
*.bak
*.bak-*
*.old-*
backup/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
